{
  // Static site on Cloudflare Workers (static assets). No server code yet.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anamnesis",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "cjtech.dev", "custom_domain": true }],
  "workers_dev": true
}
