---
import { otherLang, useT, type Lang } from '../lib/i18n';
import ThemeToggle from './ThemeToggle.astro';
import Languages from '@lucide/astro/icons/languages';
import Search from '../islands/Search';

interface Props {
  lang: Lang;
  altPath?: string;
}
const { lang, altPath } = Astro.props;
const t = useT(lang);
const alt = otherLang(lang);
const path = Astro.url.pathname;
const links = [
  { href: `/${lang}/journal/`, label: t('nav.journal') },
  { href: `/${lang}/projects/`, label: t('nav.projects') },
  { href: `/${lang}/games/`, label: t('nav.games') },
  { href: `/${lang}/ideas/`, label: t('nav.ideas') },
  { href: `/${lang}/about/`, label: t('nav.about') },
  { href: `/${lang}/stack/`, label: t('nav.stack') },
];
---

<header class="site pad">
  <a class="brand" href={`/${lang}/`}>Cesar <span>/ {lang === 'es' ? 'Diario' : 'Journal'}</span></a>
  <nav aria-label="Main">
    {links.map((l) => (
      <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>
  <a class="lang" href={altPath ?? `/${alt}/`} hreflang={alt} lang={alt}>
    <Languages size={13} aria-hidden="true" /><b>{lang.toUpperCase()}</b> / {alt.toUpperCase()}
  </a>
  <div class="tools">
    <Search
      client:idle
      labels={{ open: t('search.open'), placeholder: t('search.placeholder'), empty: t('search.empty'), devOnly: t('search.devOnly'), close: t('search.close') }}
    />
    <ThemeToggle lang={lang} />
  </div>
</header>

<style>
  .site { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; padding-block: 26px; }
  .brand { font-weight: 700; font-size: 19px; text-decoration: none; margin-right: auto; }
  .brand span { color: var(--muted); font-weight: 500; }
  nav { display: flex; flex-wrap: wrap; gap: 4px 18px; font-size: 15px; }
  nav a { text-decoration: none; color: var(--muted); }
  nav a:hover, nav a[aria-current='page'] { color: var(--ink); }
  nav a[aria-current='page'] { text-decoration: underline wavy var(--lavender); text-underline-offset: 6px; }
  .lang {
    font: 500 12px var(--font-mono); border: 1px solid var(--line); border-radius: 99px;
    padding: 4px 10px; color: var(--muted); text-decoration: none;
    display: inline-flex; align-items: center; gap: 5px;
  }
  .lang b { color: var(--ink); }
  .tools { display: flex; align-items: center; gap: 8px; }
  .lang:hover { background: var(--lavender-soft); }
  @media (max-width: 520px) { nav { order: 3; width: 100%; } }
</style>
