---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { otherLang, useT, type Lang } from '../lib/i18n';
// Preload the two weights every page uses first, so headings don't flash in a fallback font.
import font400 from '@fontsource/hanken-grotesk/files/hanken-grotesk-latin-400-normal.woff2?url';
import font600 from '@fontsource/hanken-grotesk/files/hanken-grotesk-latin-600-normal.woff2?url';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Path of this page in the other language. Set it only when that page exists. */
  altPath?: string;
  /** Social preview image path. Defaults to the site image. */
  ogImage?: string;
  /** "article" for posts. */
  ogType?: 'website' | 'article';
}

const { lang, title, description, altPath, ogImage: ogPath = '/og.png', ogType = 'website' } = Astro.props;
const t = useT(lang);
const alt = otherLang(lang);
const fullTitle = title === 'cjtech.dev' ? title : `${title} · cjtech.dev`;
const desc = description ?? t('journal.intro');
const site = Astro.site ?? new URL('https://cjtech.dev');
const canonical = new URL(Astro.url.pathname, site).href;
const altUrl = altPath ? new URL(altPath, site).href : undefined;
const ogImage = new URL(ogPath, site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    {altUrl && <link rel="alternate" hreflang={alt} href={altUrl} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="cjtech.dev" href={`/${lang}/rss.xml`} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={font400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={font600} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#eef1ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121511" media="(prefers-color-scheme: dark)" />

    <!-- Social previews (WhatsApp, LinkedIn, X...) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="cjtech.dev" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'es' ? 'es_PE' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      // Apply the saved theme before the first paint (no flash). Auto = follow the system.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch {}
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">{t('skip')}</a>
    <div class="sheet">
      <Header lang={lang} altPath={altPath} />
      <main id="main">
        <slot />
      </main>
      <Footer lang={lang} />
    </div>
  </body>
</html>

<style>
  .skip {
    position: absolute; left: 16px; top: -60px; z-index: 20; background: var(--ink); color: var(--sheet);
    padding: 10px 16px; border-radius: 99px; text-decoration: none; font-weight: 600; transition: top 0.2s;
  }
  .skip:focus { top: 12px; }
</style>
