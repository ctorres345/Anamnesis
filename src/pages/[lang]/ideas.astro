---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lightbulb from '@lucide/astro/icons/lightbulb';
import { VIDEO_STAGES } from '../../content.config';
import { LANGS, isoDay, otherLang, useT, type Lang } from '../../lib/i18n';
import { entryUrl, getEntries } from '../../lib/journal';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const ideas = (await getEntries(lang)).filter((e) => e.data.kind === 'video-idea');
const columns = VIDEO_STAGES.map((stage) => ({ stage, items: ideas.filter((i) => i.data.video?.stage === stage) }));
---

<BaseLayout lang={lang} title={`${t('ideas.title')} ${t('ideas.titleSoft')}`} description={t('ideas.intro')} altPath={`/${otherLang(lang)}/ideas/`}>
  <section class="block pad">
    <div class="sec-head">
      <h1>{t('ideas.title')} <span class="soft">{t('ideas.titleSoft')}</span></h1>
      <p>{t('ideas.intro')}</p>
    </div>
    <div class="board">
      {columns.map((col, i) => (
        <section class="col" aria-labelledby={`stage-${col.stage}`}>
          <h2 id={`stage-${col.stage}`}><span class="n mono">{String(i + 1).padStart(2, '0')}</span>{t(`stage.${col.stage}`)}<span class="count mono">{col.items.length}</span></h2>
          {col.items.length === 0 && <p class="empty">{t('ideas.empty')}</p>}
          {col.items.map((idea) => (
            <a class="idea" href={entryUrl(idea)}>
              <Lightbulb size={15} aria-hidden="true" />
              <b>{idea.data.title}</b>
              {idea.data.note && <span class="hand">↳ {idea.data.note}</span>}
              <span class="date mono">{isoDay(idea.data.date)}</span>
            </a>
          ))}
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .board { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; align-items: start; }
  .col { background: var(--lavender-soft); border-radius: var(--radius-l); padding: 14px; display: grid; gap: 10px; align-content: start; }
  @media (min-width: 861px) { .col { min-height: 160px; } }
  h2 { margin: 0; font-size: 16px; font-weight: 600; display: flex; align-items: center; gap: 8px; }
  .n { font-size: 11px; color: var(--lavender-deep); }
  .count { margin-left: auto; font-size: 12px; color: var(--muted); }
  .empty { margin: 0; font-size: 14px; color: var(--muted); }
  .idea { display: grid; gap: 6px; background: var(--butter); color: var(--on-pastel); border-radius: var(--radius-m); padding: 12px 14px; text-decoration: none; transform: rotate(-0.6deg); transition: transform var(--dur) var(--ease-pop); }
  .idea:nth-child(even) { transform: rotate(0.6deg); }
  .idea:hover { transform: rotate(0deg) translateY(-3px); }
  .idea b { font-size: 15px; line-height: 1.25; }
  .idea .hand { font-size: 18px; color: var(--on-pastel); }
  .date { font-size: 11px; opacity: 0.75; }
  @media (max-width: 860px) { .board { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  @media (max-width: 520px) { .board { grid-template-columns: minmax(0, 1fr); } }
</style>
