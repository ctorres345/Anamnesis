---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GithubMark from '../../components/GithubMark.astro';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import { LANGS, otherLang, type Lang } from '../../lib/i18n';
import { SOCIAL } from '../../lib/site';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const page = (await getCollection('pages')).find((p) => p.id === `${lang}/about`);
if (!page) throw new Error(`Missing src/content/journal/pages/${lang}/about.md`);
const { Content } = await render(page);
---

<BaseLayout lang={lang} title={page.data.title} description={page.data.summary} altPath={`/${otherLang(lang)}/about/`}>
  <section class="block pad">
    <div class="about">
      <div data-pagefind-body>
        <h1 data-pagefind-meta="title">{page.data.title}</h1>
        {page.data.summary && <p class="lede">{page.data.summary}</p>}
        <div class="prose"><Content /></div>
      </div>
      <aside data-pagefind-ignore>
        {page.data.note && <span class="hand note">↳ {page.data.note}</span>}
        <ul class="links">
          {SOCIAL.map((s) => (
            <li><a class="btn" href={s.href} rel="me">{s.logo === 'github' && <GithubMark size={16} />}{s.label}<ArrowUpRight size={15} aria-hidden="true" /></a></li>
          ))}
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .about { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 260px); gap: clamp(24px, 4vw, 56px); }
  h1 { font-weight: 600; font-size: var(--step-4); letter-spacing: -0.035em; line-height: 1.02; margin: 0 0 16px; }
  .lede { font-size: var(--step-1); color: var(--muted); margin: 0 0 20px; max-width: 58ch; }
  .prose { font-size: 17px; line-height: 1.7; max-width: 66ch; }
  .prose :global(h2) { font-size: var(--step-2); letter-spacing: -0.02em; margin: 1.6em 0 0.4em; }
  .prose :global(a) { color: var(--lavender-deep); text-underline-offset: 3px; }
  .prose :global(blockquote) { margin: 18px 0; padding: 10px 16px; border-radius: 12px; background: var(--lavender-soft); }
  .prose :global(code) { font-family: var(--font-mono); font-size: 0.9em; background: var(--lavender-soft); padding: 1px 5px; border-radius: 4px; }
  aside { display: grid; gap: 16px; align-content: start; }
  .note { transform: rotate(-1.5deg); }
  .links { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  @media (max-width: 860px) { .about { grid-template-columns: minmax(0, 1fr); } }
</style>
