---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import CodeXml from '@lucide/astro/icons/code-xml';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { LANGS, isoDay, otherLang, useT, type Lang } from '../../lib/i18n';
import { entryUrl, getEntries } from '../../lib/journal';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const projects = (await getEntries(lang)).filter((e) => e.data.kind === 'project');
---

<BaseLayout lang={lang} title={t('projects.title')} description={t('projects.intro')} altPath={`/${otherLang(lang)}/projects/`}>
  <section class="block pad">
    <div class="sec-head">
      <h1>{t('projects.title')}</h1>
      <p>{t('projects.intro')}</p>
    </div>
    <div class="grid">
      {projects.map((p) => (
        <a class="project" href={entryUrl(p)} data-kind="project">
          <div class="art">
            {p.data.cover ? <Image src={p.data.cover} alt={p.data.coverAlt ?? ''} widths={[400, 700]} sizes="(max-width: 860px) 100vw, 540px" /> : <CodeXml size={44} aria-hidden="true" />}
          </div>
          <div class="text">
            <span class="date mono">{isoDay(p.data.date)}</span>
            <h2>{p.data.title.split(':')[0]}</h2>
            {p.data.summary && <p>{p.data.summary}</p>}
            {p.data.project?.stack && p.data.project.stack.length > 0 && (
              <ul class="stack">{p.data.project.stack.map((s) => <li>{s}</li>)}</ul>
            )}
            <span class="more">{p.data.note && <span class="hand">↳ {p.data.note}</span>}<ArrowRight size={18} aria-hidden="true" /></span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr)); gap: 16px; }
  .project { display: grid; grid-template-rows: auto 1fr; border: 1px solid var(--line); border-radius: var(--radius-l); overflow: hidden; text-decoration: none; transition: transform var(--dur); }
  .project:hover { transform: translateY(-4px); }
  .art { aspect-ratio: 16 / 7; background: var(--hl); display: grid; place-items: center; color: var(--on-pastel); overflow: hidden; }
  .art :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .text { padding: 18px 20px 20px; display: grid; gap: 8px; align-content: start; }
  .date { font-size: 12px; color: var(--muted); }
  h2 { margin: 0; font-size: var(--step-2); font-weight: 600; letter-spacing: -0.02em; }
  .text p { margin: 0; color: var(--muted); }
  .stack { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 0; padding: 0; }
  .stack li { font: 500 12px var(--font-mono); background: var(--lavender-soft); border-radius: 6px; padding: 3px 8px; }
  .more { display: flex; justify-content: space-between; align-items: center; margin-top: 6px; color: var(--lavender-deep); }
  .more .hand { font-size: 20px; }
</style>
