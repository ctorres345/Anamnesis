---
// "/" has no content of its own: it sends the visitor to /es/ or /en/ based on the browser language.
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>cjtech.dev</title>
    <meta http-equiv="refresh" content="2;url=/es/" />
    <link rel="alternate" hreflang="es" href="/es/" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <script is:inline>
      const langs = navigator.languages || [navigator.language || 'es'];
      const en = langs.find((l) => /^(en|es)/i.test(l))?.toLowerCase().startsWith('en');
      location.replace(en ? '/en/' : '/es/');
    </script>
  </head>
  <body>
    <p><a href="/es/">Español</a> · <a href="/en/">English</a></p>
  </body>
</html>
